#!/usr/bin/env python3
"""arcadectl — CLI for arcaded (M0: status, cab exec).

Stdlib only. --json on everything (AGT-1); meaningful exit codes; no prompts.
Exit: 0 ok, 1 remote command failed (rc!=0), 2 usage, 3 server unreachable,
4 API/transport error (HTTP status from arcaded).
"""
import argparse
import json
import os
import pathlib
import sys
import urllib.error
import urllib.parse
import urllib.request

def server_url(config_path="/etc/arcade/cabinet.env"):
    """Cabinet agents are noninteractive: don't depend on shell profiles."""
    if os.environ.get("ARCADED_URL"):
        return os.environ["ARCADED_URL"].rstrip("/")
    if os.environ.get("CABD_MEDIA_BASE"):
        return os.environ["CABD_MEDIA_BASE"].rstrip("/")
    config = pathlib.Path(config_path)
    if config.exists():
        for line in config.read_text().splitlines():
            key, sep, value = line.strip().partition("=")
            if sep and key == "CABD_MEDIA_BASE":
                return value.strip().strip("\"'").rstrip("/")
    return "http://localhost:8000"


BASE = server_url()


def call(method, path, body=None):
    req = urllib.request.Request(BASE + path, method=method)
    req.add_header("User-Agent", "Mozilla/5.0 (compatible; arcadectl/1.1; +https://github.com/joey12725/Arcade-Relay)")
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, data=data, timeout=60) as r:
            return json.loads(r.read() or "{}")
    except urllib.error.HTTPError as e:
        print(f"arcadectl: {e.code} {e.read().decode(errors='replace')}",
              file=sys.stderr)
        sys.exit(4)
    except (urllib.error.URLError, OSError) as e:
        print(f"arcadectl: cannot reach arcaded at {BASE}: {e}", file=sys.stderr)
        sys.exit(3)


def _hold_ms(spec):
    """'2s' | '500ms' | '0' | '1.5' (seconds) -> milliseconds."""
    s = str(spec).strip().lower()
    try:
        if s.endswith("ms"):
            return int(float(s[:-2]))
        if s.endswith("s"):
            return int(float(s[:-1]) * 1000)
        return int(float(s) * 1000)
    except ValueError:
        print(f"arcadectl: bad hold time {spec!r} (try 2s, 500ms, 0)",
              file=sys.stderr)
        sys.exit(2)


def main():
    ap = argparse.ArgumentParser(prog="arcadectl")
    ap.add_argument("--json", action="store_true", dest="as_json")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status")
    ev = sub.add_parser("events")
    ev.add_argument("--limit", type=int, default=50)

    games = sub.add_parser("games")
    gsub = games.add_subparsers(dest="gamescmd", required=True)
    gl = gsub.add_parser("launch")
    gl.add_argument("query", nargs="?",
                    help="fuzzy game query (alternative to --system/--path)")
    gl.add_argument("--exact", action="store_true",
                    help="query must equal the game id or filename")
    gl.add_argument("--system")
    gl.add_argument("--path")
    gl.add_argument("--args", default="", help="extra emulator args (space-separated)")
    gsub.add_parser("kill")
    gsub.add_parser("running")
    gls = gsub.add_parser("list")
    gls.add_argument("--system")
    gls.add_argument("--favorites", action="store_true")

    roms = sub.add_parser("roms")
    rsub = roms.add_subparsers(dest="romscmd", required=True)
    rs = rsub.add_parser("search")
    rs.add_argument("query")
    rs.add_argument("--system", help="nes, snes, psx, ... (required by the "
                                     "real ROMDL backend)")
    rs.add_argument("--limit", type=int, default=10)
    rs.add_argument("--deep", action="store_true",
                    help="more permissive matching, deeper crawl")
    rr = rsub.add_parser("request")
    rr.add_argument("query", nargs="?", help="omit when using --id")
    rr.add_argument("--system")
    rr.add_argument("--id", help="queue an exact candidate from a search")
    rsub.add_parser("queue")
    rsub.add_parser("status")
    rsub.add_parser("sync")
    rsub.add_parser("backend", help="which ROMDL backend and source coverage")
    rrt = rsub.add_parser("retry")
    rrt.add_argument("id")
    rc = rsub.add_parser("cancel")
    rc.add_argument("id")

    ss = sub.add_parser("screensaver")
    sssub = ss.add_subparsers(dest="sscmd", required=True)
    for c in ("status", "sources", "playlist", "on", "off", "toggle"):
        sssub.add_parser(c)
    sset = sssub.add_parser("set")
    sset.add_argument("--brightness", type=int, help="0–200%% (0 black, 100 original, 200 white)")
    sset.add_argument("--idle", type=int, dest="idle_seconds")
    sset.add_argument("--mode", choices=["shuffle_episodes", "continue_series"])
    sset.add_argument("--fallback", choices=["local_clips", "dim_clock", "off"],
                      help="what to show when no playlist is available")
    sset.add_argument("--aspect", choices=["crop", "bars", "stretch"])
    sset.add_argument("--shuffle", choices=["in_order", "random_episode",
                                            "even_series", "round_robin", "decay"])
    sset.add_argument("--commercial-count", type=int, choices=range(6),
                      help="commercials between episodes (0 disables)")
    sset.add_argument("--commercial-source", action="append", metavar="URL",
                      help="replace selected commercial sources with these YouTube URLs; repeatable")
    sset.add_argument("--skip-intro", type=int, dest="skip_intro_s")
    sset.add_argument("--skip-outro", type=int, dest="skip_outro_s")
    sset.add_argument("--subtitles", choices=["on", "off"],
                      help="English subtitles on the anime (best track is "
                           "picked automatically)")
    for c in ("enable-source", "disable-source", "remove-source"):
        sp = sssub.add_parser(c)
        sp.add_argument("id")
    sd = sssub.add_parser("disable")
    sd.add_argument("--for", dest="duration", required=True,
                    help="e.g. 2h, 30m, 45 (seconds); 0 clears")

    pl = sssub.add_parser("playlists", help="named sets of shows (christmas, "
                          "halloween, sfw...) the screensaver can switch between")
    plsub = pl.add_subparsers(dest="plcmd", required=True)
    plsub.add_parser("list", help="every playlist and which is active")
    plc = plsub.add_parser("create", help="make a new playlist (optionally "
                           "seeded); fails if the name exists")
    plc.add_argument("name")
    plc.add_argument("--source", action="append", default=[], metavar="ID",
                     help="a source id from `screensaver sources`; repeatable")
    for c in ("add", "remove"):
        pa = plsub.add_parser(c, help=f"{c} sources "
                              + ("to" if c == "add" else "from") + " a playlist")
        pa.add_argument("name")
        pa.add_argument("ids", nargs="+", metavar="ID")
    pd = plsub.add_parser("delete")
    pd.add_argument("name")
    pse = plsub.add_parser("select", help="play this playlist; `all` returns "
                           "to every enabled source")
    pse.add_argument("name")

    vol = sub.add_parser("volume")
    vsub = vol.add_subparsers(dest="volcmd", required=True)
    vsub.add_parser("get")
    vs = vsub.add_parser("set")
    vs.add_argument("--master", type=int)
    vs.add_argument("--class", dest="cls")
    vs.add_argument("--volume", type=int)
    mg = vs.add_mutually_exclusive_group()
    mg.add_argument("--mute", action="store_true")
    mg.add_argument("--unmute", action="store_true")

    st = sub.add_parser("state")
    stsub = st.add_subparsers(dest="statecmd", required=True)
    stsub.add_parser("push")
    stsub.add_parser("bundle")
    stsub.add_parser("log")
    sdf = stsub.add_parser("diff")
    sdf.add_argument("rev", nargs="?", default="HEAD~1",
                     help="git rev to diff against HEAD (default HEAD~1)")
    rb = stsub.add_parser("rollback")
    rb.add_argument("commit")

    ct = sub.add_parser("controls")
    csub = ct.add_subparsers(dest="ctlcmd", required=True)
    csub.add_parser("list-presets")
    cd = csub.add_parser("diff")
    cd.add_argument("a")
    cd.add_argument("b")
    for c in ("save-preset", "load-preset"):
        cp = csub.add_parser(c)
        cp.add_argument("name")
    cm = csub.add_parser("map")
    cm.add_argument("--scope", required=True,
                    help="global | system:<sys> | game:<sys>/<rom>")
    cm.add_argument("--set", dest="sets", action="append", required=True,
                    metavar="BTN=TARGET")
    cbind = csub.add_parser("bind", help="combo / hold-to-trigger binding")
    cbind.add_argument("--scope", required=True,
                       help="global | system:<sys> | game:<sys>/<rom>")
    cbind.add_argument("--buttons", required=True,
                       help="one button or a combo, e.g. l+r")
    cbind.add_argument("--hold", default="0",
                       help="hold time before it fires, e.g. 2s, 500ms, 0")
    cbind.add_argument("--target", required=True,
                       help="pad button (a, start, ...) or action "
                            "(screensaver, save_state, quit, ...)")
    cub = csub.add_parser("unbind-combo")
    cub.add_argument("--scope", required=True)
    cub.add_argument("--buttons", required=True)
    cub.add_argument("--hold", default="0")
    cu = csub.add_parser("unbind")
    cu.add_argument("--scope", required=True,
                    help="global | system:<sys> | game:<sys>/<rom>")
    cu.add_argument("keys", nargs="+", metavar="BTN")
    cb = csub.add_parser("bindings")
    cb.add_argument("--scope", default="global")
    csub.add_parser("scopes")
    csub.add_parser("devices")
    mon = csub.add_parser("monitor")
    mon.add_argument("--for", dest="seconds", type=float, default=2)

    art = sub.add_parser("art", help="box art cache (libretro-thumbnails)")
    artsub = art.add_subparsers(dest="artcmd", required=True)
    artsub.add_parser("status")
    artsub.add_parser("warm", help="fetch art for the whole library")
    artsub.add_parser("push", help="deliver cached art to the cabinet")

    fav = sub.add_parser("favorites")
    fsub = fav.add_subparsers(dest="favcmd", required=True)
    for c in ("add", "remove"):
        fp = fsub.add_parser(c)
        fp.add_argument("id", help="<system>/<rom-basename>, or a fuzzy query")
    fsub.add_parser("list")

    stream = sub.add_parser("stream")
    stsub2 = stream.add_subparsers(dest="streamcmd", required=True)
    stsub2.add_parser("apps")
    sl = stsub2.add_parser("launch")
    sl.add_argument("app", help="app name (case-insensitive substring)")
    sq = stsub2.add_parser("set-quality")
    sq.add_argument("app", nargs="?", default="defaults",
                    help="app name, or 'defaults' for every app")
    sq.add_argument("--resolution", help="e.g. 1920x1080")
    sq.add_argument("--fps", type=int)
    sq.add_argument("--bitrate", type=int, dest="bitrate_kbps",
                    help="kbps (LAN stream, not the tunnel)")

    cab = sub.add_parser("cab")
    cabsub = cab.add_subparsers(dest="cabcmd", required=True)
    ex = cabsub.add_parser("exec")
    ex.add_argument("argv", nargs=argparse.REMAINDER,
                    help="command to run on the cabinet (after --)")
    cabsub.add_parser("screenshot")
    cabsub.add_parser("reboot")
    cabsub.add_parser("restart-frontend")
    ip = cabsub.add_parser("press")
    ip.add_argument("key", help="home|screensaver|lifeline, or an X key spec")
    it = cabsub.add_parser("type")
    it.add_argument("text")
    lf = cabsub.add_parser("lifeline")
    lf.add_argument("action", choices=["on", "off", "restart-network"])
    rvp = cabsub.add_parser("remote-view")
    rvp.add_argument("--off", action="store_true",
                     help="stop the VNC session instead of starting one")
    lg = cabsub.add_parser("logs")
    lg.add_argument("-f", "--follow", action="store_true")
    lg.add_argument("--lines", type=int, default=200)

    args = ap.parse_args()

    if args.cmd == "status":
        st = call("GET", "/status")
        if args.as_json:
            print(json.dumps(st))
        else:
            print(f"cabinet: {'ONLINE' if st['online'] else 'OFFLINE'} "
                  f"(hb age {st['heartbeat_age_s']}s, "
                  f"interval {st['heartbeat_interval_s']}s, "
                  f"connects {st['connects']})")
        sys.exit(0)

    if args.cmd == "games":
        if args.gamescmd == "list":
            qs = []
            if args.system:
                qs.append("system=" + urllib.parse.quote(args.system))
            if args.favorites:
                qs.append("favorites=1")
            res = call("GET", "/games/list" + ("?" + "&".join(qs) if qs else ""))
            if args.as_json:
                print(json.dumps(res))
            else:
                for g in res["games"]:
                    print(("* " if g["favorite"] else "  ") + g["id"])
            sys.exit(0)
        if args.gamescmd == "launch":
            if args.query and not (args.system or args.path):
                res = call("POST", "/games/launch-query",
                           {"query": args.query, "exact": args.exact})
            elif args.system and args.path and not args.query:
                res = call("POST", "/games/launch",
                           {"system": args.system, "path": args.path,
                            "args": args.args.split() if args.args else []})
            else:
                print("usage: games launch <query> [--exact] "
                      "| games launch --system S --path P", file=sys.stderr)
                sys.exit(2)
        elif args.gamescmd == "kill":
            res = call("POST", "/games/kill")
        else:  # running
            res = {"running": call("GET", "/status")["cabinet_state"].get("running")}
        print(json.dumps(res) if args.as_json else res.get("running") or "nothing")
        sys.exit(0)

    if args.cmd == "stream":
        if args.streamcmd == "apps":
            res = call("GET", "/stream/apps")
        elif args.streamcmd == "set-quality":
            body = {"app": args.app}
            for k in ("resolution", "fps", "bitrate_kbps"):
                v = getattr(args, k, None)
                if v is not None:
                    body[k] = v
            res = call("POST", "/stream/set-quality", body)
        else:
            res = call("POST", "/stream/launch", {"app": args.app})
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "roms":
        if args.romscmd == "search":
            qs = ["q=" + urllib.parse.quote(args.query),
                  "limit=%d" % args.limit]
            if args.system:
                qs.append("system=" + urllib.parse.quote(args.system))
            if args.deep:
                qs.append("deep=1")
            res = call("GET", "/roms/search?" + "&".join(qs))
            # a dead upstream source reads as "no results" otherwise
            if isinstance(res, dict) and res.get("note"):
                print("arcadectl: " + res["note"], file=sys.stderr)
        elif args.romscmd == "request":
            if not args.query and not args.id:
                print("usage: roms request <query> [--system S] | --id ID",
                      file=sys.stderr)
                sys.exit(2)
            body = {}
            for k, v in (("query", args.query), ("system", args.system),
                         ("id", args.id)):
                if v:
                    body[k] = v
            res = call("POST", "/roms/request", body)
        elif args.romscmd == "sync":
            res = call("POST", "/roms/sync")
        elif args.romscmd == "backend":
            res = call("GET", "/roms/backend")
        elif args.romscmd == "retry":
            res = call("POST", "/roms/retry", {"id": args.id})
        elif args.romscmd == "cancel":
            res = call("POST", "/roms/cancel", {"id": args.id})
        else:
            res = call("GET", "/roms/status")
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "screensaver":
        c = args.sscmd
        if c == "status":
            res = call("GET", "/screensaver")
        elif c == "sources":
            res = call("GET", "/screensaver/sources")
        elif c == "playlist":
            res = call("GET", "/screensaver/playlist")
        elif c == "toggle":
            on_now = call("GET", "/status")["cabinet_state"].get("screensaver")
            res = call("POST", f"/screensaver/{'off' if on_now else 'on'}")
        elif c in ("on", "off"):
            res = call("POST", f"/screensaver/{c}")
        elif c == "disable":
            d = args.duration
            mult = {"h": 3600, "m": 60, "s": 1}.get(d[-1], None)
            secs = float(d[:-1]) * mult if mult else float(d)
            res = call("POST", "/screensaver/disable", {"seconds": secs})
        elif c == "set":
            body = {k: v for k, v in
                    (("brightness", args.brightness),
                     ("idle_seconds", args.idle_seconds),
                     ("mode", args.mode),
                     ("fallback", args.fallback),
                     ("aspect", args.aspect),
                     ("shuffle", args.shuffle),
                     ("commercial_count", args.commercial_count),
                     ("skip_intro_s", args.skip_intro_s),
                     ("skip_outro_s", args.skip_outro_s)) if v is not None}
            if args.commercial_source is not None:
                body["commercial_sources"] = [{"url": url, "enabled": True}
                                              for url in args.commercial_source]
            if args.subtitles is not None:
                body["subtitles"] = args.subtitles == "on"
            res = call("POST", "/screensaver/set", body)
        elif c == "remove-source":
            res = call("POST", "/screensaver/remove-source", {"id": args.id})
        elif c == "playlists":
            pc = args.plcmd
            if pc == "list":
                res = call("GET", "/screensaver/playlists")
            elif pc == "create":
                res = call("POST", "/screensaver/playlists/save",
                           {"name": args.name, "create": True, "sources": args.source})
            elif pc in ("add", "remove"):
                res = call("POST", "/screensaver/playlists/save",
                           {"name": args.name, ("add" if pc == "add" else "remove"): args.ids})
            elif pc == "delete":
                res = call("POST", "/screensaver/playlists/delete", {"name": args.name})
            else:
                res = call("POST", "/screensaver/playlists/select", {"name": args.name})
        else:
            res = call("POST", "/screensaver/set-source",
                       {"id": args.id, "enabled": c == "enable-source"})
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "volume":
        if args.volcmd == "get":
            res = call("GET", "/volume")
        else:
            body = {}
            if args.master is not None:
                body["master"] = args.master
            if args.cls:
                body["class"] = args.cls
                if args.volume is not None:
                    body["volume"] = args.volume
                if args.mute:
                    body["muted"] = True
                elif args.unmute:
                    body["muted"] = False
            res = call("POST", "/volume/set", body)
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "state":
        if args.statecmd == "push":
            res = call("POST", "/state/push")
        elif args.statecmd == "log":
            res = call("GET", "/state/log")
        elif args.statecmd == "rollback":
            res = call("POST", "/state/rollback", {"commit": args.commit})
        elif args.statecmd == "diff":
            res = call("GET", "/state/diff?rev=" + urllib.parse.quote(args.rev))
            if not args.as_json:
                print(res["diff"], end="")
                sys.exit(0)
        else:
            res = call("GET", "/state/bundle")
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "art":
        if args.artcmd == "status":
            res = call("GET", "/art/status")
        else:
            res = call("POST", "/art/" + args.artcmd)
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "controls":
        if args.ctlcmd == "list-presets":
            res = call("GET", "/controls/presets")
        elif args.ctlcmd == "scopes":
            res = call("GET", "/controls/scopes")
        elif args.ctlcmd == "devices":
            res = call("GET", "/controls/devices")
        elif args.ctlcmd == "bindings":
            res = call("GET", "/controls/bindings?scope="
                       + urllib.parse.quote(args.scope))
        elif args.ctlcmd == "unbind":
            res = call("POST", "/controls/unbind",
                       {"scope": args.scope, "keys": args.keys})
        elif args.ctlcmd == "bind":
            res = call("POST", "/controls/bind",
                       {"scope": args.scope,
                        "buttons": args.buttons.split("+"),
                        "hold_ms": _hold_ms(args.hold),
                        "target": args.target})
        elif args.ctlcmd == "unbind-combo":
            res = call("POST", "/controls/unbind-combo",
                       {"scope": args.scope,
                        "buttons": args.buttons.split("+"),
                        "hold_ms": _hold_ms(args.hold)})
        elif args.ctlcmd == "diff":
            res = call("GET", "/controls/diff?a=" + urllib.parse.quote(args.a)
                       + "&b=" + urllib.parse.quote(args.b))
        elif args.ctlcmd == "save-preset":
            res = call("POST", "/controls/save-preset", {"name": args.name})
        elif args.ctlcmd == "load-preset":
            res = call("POST", "/controls/load-preset", {"name": args.name})
        elif args.ctlcmd == "map":
            sets = dict(s.split("=", 1) for s in args.sets)
            res = call("POST", "/controls/map", {"scope": args.scope, "set": sets})
        else:  # monitor
            res = call("POST", "/controls/monitor", {"seconds": args.seconds})
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "favorites":
        if args.favcmd == "list":
            res = call("GET", "/favorites")
        else:
            fav_id = args.id
            if "/" not in fav_id:   # fuzzy query -> resolve against the library
                games = call("GET", "/games/list")["games"]
                q = fav_id.lower()
                hits = [g for g in games if q in g["id"].lower()]
                if len(hits) > 1:   # same exact-ish narrowing as games launch
                    narrowed = [g for g in hits if q in (
                        g["id"].lower(), g["file"].lower(),
                        os.path.splitext(g["file"])[0].lower())]
                    if len(narrowed) == 1:
                        hits = narrowed
                if not hits:
                    print(f"arcadectl: no game matches {fav_id!r}", file=sys.stderr)
                    sys.exit(4)
                if len(hits) > 1:
                    print(f"arcadectl: ambiguous {fav_id!r}: "
                          + ", ".join(g["id"] for g in hits), file=sys.stderr)
                    sys.exit(4)
                fav_id = hits[0]["id"]
            res = call("POST", f"/favorites/{args.favcmd}", {"id": fav_id})
        print(json.dumps(res) if args.as_json else "\n".join(res["favorites"]) or "(none)")
        sys.exit(0)

    if args.cmd == "events":
        res = call("GET", "/events")
        if args.as_json:
            print(json.dumps(res[-args.limit:]))
        else:
            for e in res[-args.limit:]:
                print(f"{e['ts']:.0f} {e['event']}")
        sys.exit(0)

    if args.cmd == "cab" and args.cabcmd in ("press", "type"):
        body = {"key": args.key} if args.cabcmd == "press" else {"text": args.text}
        res = call("POST", "/cab/input", body)
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "cab" and args.cabcmd in ("reboot", "restart-frontend"):
        res = call("POST", f"/cab/{args.cabcmd}")
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "cab" and args.cabcmd == "lifeline":
        res = call("POST", f"/cab/lifeline/{args.action}")
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "cab" and args.cabcmd == "remote-view":
        res = call("POST", "/cab/remote-view", {"on": not args.off})
        if args.as_json:
            print(json.dumps(res))
        elif res.get("remote_view"):
            print(f"remote view ON — connect a VNC client to port {res['port']} "
                  f"on the server ({res['url']})")
        else:
            print("remote view OFF")
        sys.exit(0)

    if args.cmd == "cab" and args.cabcmd == "logs":
        import time as _time
        since = 0
        while True:
            try:
                res = call("GET", f"/cab/logs?since={since}&lines={args.lines}")
            except SystemExit:
                if not args.follow:   # one-shot keeps normal exit-code contract
                    raise
                _time.sleep(1)        # cabinet offline/restarting: keep following
                continue
            for seq, ts, line in res["lines"]:
                print(json.dumps({"seq": seq, "ts": ts, "line": line})
                      if args.as_json else f"{ts} {line}")
            since = res["next"]
            if not args.follow:
                sys.exit(0)
            sys.stdout.flush()
            try:
                _time.sleep(1)
            except KeyboardInterrupt:
                sys.exit(0)

    if args.cmd == "cab" and args.cabcmd == "screenshot":
        req = urllib.request.Request(BASE + "/cab/screenshot")
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                sys.stdout.buffer.write(r.read())
            sys.exit(0)
        except urllib.error.HTTPError as e:
            print(f"arcadectl: {e.code}", file=sys.stderr)
            sys.exit(4)

    if args.cmd == "cab" and args.cabcmd == "exec":
        argv = args.argv
        if argv and argv[0] == "--":
            argv = argv[1:]
        if not argv:
            print("usage: arcadectl cab exec -- <cmd...>", file=sys.stderr)
            sys.exit(2)
        res = call("POST", "/cab/exec", {"cmd": " ".join(argv)})
        if args.as_json:
            print(json.dumps(res))
        else:
            sys.stdout.write(res["stdout"])
            sys.stderr.write(res["stderr"])
        sys.exit(0 if res["rc"] == 0 else 1)


if __name__ == "__main__":
    main()
