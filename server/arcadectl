#!/usr/bin/env python3
"""arcadectl — CLI for arcaded (M0: status, cab exec).

Stdlib only. --json on everything (AGT-1); meaningful exit codes; no prompts.
Exit: 0 ok, 1 remote command failed (rc!=0), 2 usage, 3 server unreachable,
4 API/transport error (HTTP status from arcaded).
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

BASE = os.environ.get("ARCADED_URL", "http://localhost:8000")


def call(method, path, body=None):
    req = urllib.request.Request(BASE + path, method=method)
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, data=data, timeout=30) as r:
            return json.loads(r.read() or "{}")
    except urllib.error.HTTPError as e:
        print(f"arcadectl: {e.code} {e.read().decode(errors='replace')}",
              file=sys.stderr)
        sys.exit(4)
    except (urllib.error.URLError, OSError) as e:
        print(f"arcadectl: cannot reach arcaded at {BASE}: {e}", file=sys.stderr)
        sys.exit(3)


def main():
    ap = argparse.ArgumentParser(prog="arcadectl")
    ap.add_argument("--json", action="store_true", dest="as_json")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status")

    games = sub.add_parser("games")
    gsub = games.add_subparsers(dest="gamescmd", required=True)
    gl = gsub.add_parser("launch")
    gl.add_argument("--system", required=True)
    gl.add_argument("--path", required=True)
    gl.add_argument("--args", default="", help="extra emulator args (space-separated)")
    gsub.add_parser("kill")
    gsub.add_parser("running")

    roms = sub.add_parser("roms")
    rsub = roms.add_subparsers(dest="romscmd", required=True)
    rs = rsub.add_parser("search")
    rs.add_argument("query")
    rr = rsub.add_parser("request")
    rr.add_argument("query")
    rsub.add_parser("queue")
    rsub.add_parser("status")

    ss = sub.add_parser("screensaver")
    sssub = ss.add_subparsers(dest="sscmd", required=True)
    for c in ("status", "sources", "playlist", "on", "off"):
        sssub.add_parser(c)
    sset = sssub.add_parser("set")
    sset.add_argument("--brightness", type=int)
    sset.add_argument("--idle", type=int, dest="idle_seconds")
    sset.add_argument("--mode")
    for c in ("enable-source", "disable-source"):
        sp = sssub.add_parser(c)
        sp.add_argument("id")
    sd = sssub.add_parser("disable")
    sd.add_argument("--for", dest="duration", required=True,
                    help="e.g. 2h, 30m, 45 (seconds); 0 clears")

    vol = sub.add_parser("volume")
    vsub = vol.add_subparsers(dest="volcmd", required=True)
    vsub.add_parser("get")
    vs = vsub.add_parser("set")
    vs.add_argument("--master", type=int)
    vs.add_argument("--class", dest="cls")
    vs.add_argument("--volume", type=int)
    mg = vs.add_mutually_exclusive_group()
    mg.add_argument("--mute", action="store_true")
    mg.add_argument("--unmute", action="store_true")

    st = sub.add_parser("state")
    stsub = st.add_subparsers(dest="statecmd", required=True)
    stsub.add_parser("push")
    stsub.add_parser("bundle")
    stsub.add_parser("log")
    rb = stsub.add_parser("rollback")
    rb.add_argument("commit")

    ct = sub.add_parser("controls")
    csub = ct.add_subparsers(dest="ctlcmd", required=True)
    csub.add_parser("list-presets")
    for c in ("save-preset", "load-preset"):
        cp = csub.add_parser(c)
        cp.add_argument("name")
    cm = csub.add_parser("map")
    cm.add_argument("--scope", required=True, help="global | system:<sys>")
    cm.add_argument("--set", dest="sets", action="append", required=True,
                    metavar="BTN=TARGET")
    mon = csub.add_parser("monitor")
    mon.add_argument("--for", dest="seconds", type=float, default=2)

    fav = sub.add_parser("favorites")
    fsub = fav.add_subparsers(dest="favcmd", required=True)
    for c in ("add", "remove"):
        fp = fsub.add_parser(c)
        fp.add_argument("id", help="<system>/<rom-basename>")
    fsub.add_parser("list")

    cab = sub.add_parser("cab")
    cabsub = cab.add_subparsers(dest="cabcmd", required=True)
    ex = cabsub.add_parser("exec")
    ex.add_argument("argv", nargs=argparse.REMAINDER,
                    help="command to run on the cabinet (after --)")

    args = ap.parse_args()

    if args.cmd == "status":
        st = call("GET", "/status")
        if args.as_json:
            print(json.dumps(st))
        else:
            print(f"cabinet: {'ONLINE' if st['online'] else 'OFFLINE'} "
                  f"(hb age {st['heartbeat_age_s']}s, "
                  f"interval {st['heartbeat_interval_s']}s, "
                  f"connects {st['connects']})")
        sys.exit(0)

    if args.cmd == "games":
        if args.gamescmd == "launch":
            res = call("POST", "/games/launch",
                       {"system": args.system, "path": args.path,
                        "args": args.args.split() if args.args else []})
        elif args.gamescmd == "kill":
            res = call("POST", "/games/kill")
        else:  # running
            res = {"running": call("GET", "/status")["cabinet_state"].get("running")}
        print(json.dumps(res) if args.as_json else res.get("running") or "nothing")
        sys.exit(0)

    if args.cmd == "roms":
        if args.romscmd == "search":
            res = call("GET", "/roms/search?q=" +
                       urllib.parse.quote(args.query))
        elif args.romscmd == "request":
            res = call("POST", "/roms/request", {"query": args.query})
        else:
            res = call("GET", "/roms/status")
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "screensaver":
        c = args.sscmd
        if c == "status":
            res = call("GET", "/screensaver")
        elif c == "sources":
            res = call("GET", "/screensaver/sources")
        elif c == "playlist":
            res = call("GET", "/screensaver/playlist")
        elif c in ("on", "off"):
            res = call("POST", f"/screensaver/{c}")
        elif c == "disable":
            d = args.duration
            mult = {"h": 3600, "m": 60, "s": 1}.get(d[-1], None)
            secs = float(d[:-1]) * mult if mult else float(d)
            res = call("POST", "/screensaver/disable", {"seconds": secs})
        elif c == "set":
            body = {k: v for k, v in
                    (("brightness", args.brightness),
                     ("idle_seconds", args.idle_seconds),
                     ("mode", args.mode)) if v is not None}
            res = call("POST", "/screensaver/set", body)
        else:
            res = call("POST", "/screensaver/set-source",
                       {"id": args.id, "enabled": c == "enable-source"})
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "volume":
        if args.volcmd == "get":
            res = call("GET", "/volume")
        else:
            body = {}
            if args.master is not None:
                body["master"] = args.master
            if args.cls:
                body["class"] = args.cls
                if args.volume is not None:
                    body["volume"] = args.volume
                if args.mute:
                    body["muted"] = True
                elif args.unmute:
                    body["muted"] = False
            res = call("POST", "/volume/set", body)
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "state":
        if args.statecmd == "push":
            res = call("POST", "/state/push")
        elif args.statecmd == "log":
            res = call("GET", "/state/log")
        elif args.statecmd == "rollback":
            res = call("POST", "/state/rollback", {"commit": args.commit})
        else:
            res = call("GET", "/state/bundle")
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "controls":
        if args.ctlcmd == "list-presets":
            res = call("GET", "/controls/presets")
        elif args.ctlcmd == "save-preset":
            res = call("POST", "/controls/save-preset", {"name": args.name})
        elif args.ctlcmd == "load-preset":
            res = call("POST", "/controls/load-preset", {"name": args.name})
        elif args.ctlcmd == "map":
            sets = dict(s.split("=", 1) for s in args.sets)
            res = call("POST", "/controls/map", {"scope": args.scope, "set": sets})
        else:  # monitor
            res = call("POST", "/controls/monitor", {"seconds": args.seconds})
        print(json.dumps(res))
        sys.exit(0)

    if args.cmd == "favorites":
        if args.favcmd == "list":
            res = call("GET", "/favorites")
        else:
            res = call("POST", f"/favorites/{args.favcmd}", {"id": args.id})
        print(json.dumps(res) if args.as_json else "\n".join(res["favorites"]) or "(none)")
        sys.exit(0)

    if args.cmd == "cab" and args.cabcmd == "exec":
        argv = args.argv
        if argv and argv[0] == "--":
            argv = argv[1:]
        if not argv:
            print("usage: arcadectl cab exec -- <cmd...>", file=sys.stderr)
            sys.exit(2)
        res = call("POST", "/cab/exec", {"cmd": " ".join(argv)})
        if args.as_json:
            print(json.dumps(res))
        else:
            sys.stdout.write(res["stdout"])
            sys.stderr.write(res["stderr"])
        sys.exit(0 if res["rc"] == 0 else 1)


if __name__ == "__main__":
    main()
