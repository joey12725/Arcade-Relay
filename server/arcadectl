#!/usr/bin/env python3
"""arcadectl — CLI for arcaded (M0: status, cab exec).

Stdlib only. --json on everything (AGT-1); meaningful exit codes; no prompts.
Exit: 0 ok, 1 remote command failed (rc!=0), 2 usage, 3 server unreachable,
4 API/transport error (HTTP status from arcaded).
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request

BASE = os.environ.get("ARCADED_URL", "http://localhost:8000")


def call(method, path, body=None):
    req = urllib.request.Request(BASE + path, method=method)
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, data=data, timeout=30) as r:
            return json.loads(r.read() or "{}")
    except urllib.error.HTTPError as e:
        print(f"arcadectl: {e.code} {e.read().decode(errors='replace')}",
              file=sys.stderr)
        sys.exit(4)
    except (urllib.error.URLError, OSError) as e:
        print(f"arcadectl: cannot reach arcaded at {BASE}: {e}", file=sys.stderr)
        sys.exit(3)


def main():
    ap = argparse.ArgumentParser(prog="arcadectl")
    ap.add_argument("--json", action="store_true", dest="as_json")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status")

    games = sub.add_parser("games")
    gsub = games.add_subparsers(dest="gamescmd", required=True)
    gl = gsub.add_parser("launch")
    gl.add_argument("--system", required=True)
    gl.add_argument("--path", required=True)
    gl.add_argument("--args", default="", help="extra emulator args (space-separated)")
    gsub.add_parser("kill")
    gsub.add_parser("running")

    cab = sub.add_parser("cab")
    cabsub = cab.add_subparsers(dest="cabcmd", required=True)
    ex = cabsub.add_parser("exec")
    ex.add_argument("argv", nargs=argparse.REMAINDER,
                    help="command to run on the cabinet (after --)")

    args = ap.parse_args()

    if args.cmd == "status":
        st = call("GET", "/status")
        if args.as_json:
            print(json.dumps(st))
        else:
            print(f"cabinet: {'ONLINE' if st['online'] else 'OFFLINE'} "
                  f"(hb age {st['heartbeat_age_s']}s, "
                  f"interval {st['heartbeat_interval_s']}s, "
                  f"connects {st['connects']})")
        sys.exit(0)

    if args.cmd == "games":
        if args.gamescmd == "launch":
            res = call("POST", "/games/launch",
                       {"system": args.system, "path": args.path,
                        "args": args.args.split() if args.args else []})
        elif args.gamescmd == "kill":
            res = call("POST", "/games/kill")
        else:  # running
            res = {"running": call("GET", "/status")["cabinet_state"].get("running")}
        print(json.dumps(res) if args.as_json else res.get("running") or "nothing")
        sys.exit(0)

    if args.cmd == "cab" and args.cabcmd == "exec":
        argv = args.argv
        if argv and argv[0] == "--":
            argv = argv[1:]
        if not argv:
            print("usage: arcadectl cab exec -- <cmd...>", file=sys.stderr)
            sys.exit(2)
        res = call("POST", "/cab/exec", {"cmd": " ".join(argv)})
        if args.as_json:
            print(json.dumps(res))
        else:
            sys.stdout.write(res["stdout"])
            sys.stderr.write(res["stderr"])
        sys.exit(0 if res["rc"] == 0 else 1)


if __name__ == "__main__":
    main()
