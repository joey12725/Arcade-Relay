#!/usr/bin/env python3
"""Fake Steam client (A-8): real X window, killed via SIGTERM by cabd.
Usage: steam steam://rungameid/<id> [...]
"""
import ctypes
import signal
import subprocess
import sys


def _die_with_parent():
    ctypes.CDLL("libc.so.6", use_errno=True).prctl(1, signal.SIGKILL)


app = (sys.argv[1].split("/")[-1] if len(sys.argv) > 1 else "unknown")
mpv = subprocess.Popen(
    ["mpv", "--no-config", "--vo=x11", "--force-window=yes",
     "--ao=pulse,pipewire,null", "--loop=inf", "--really-quiet",
     f"--title=steam-fake {app}", "av://lavfi:sine=frequency=240"],
    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    preexec_fn=_die_with_parent)


def bail(*_):
    mpv.terminate()
    sys.exit(0)


signal.signal(signal.SIGTERM, bail)
signal.signal(signal.SIGINT, bail)
sys.exit(mpv.wait())
