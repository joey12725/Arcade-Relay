#!/usr/bin/env python3
"""Fake Greenlight (xCloud) client (A-8): real X window, SIGTERM-clean.
Best-effort tier per spec — if the real client breaks, the tile just fails.
Usage: greenlight <title-or-url>
"""
import ctypes
import signal
import subprocess
import sys


def _die_with_parent():
    ctypes.CDLL("libc.so.6", use_errno=True).prctl(1, signal.SIGKILL)


title = sys.argv[1] if len(sys.argv) > 1 else "xcloud"
mpv = subprocess.Popen(
    ["mpv", "--no-config", "--vo=x11", "--force-window=yes",
     "--ao=pulse,pipewire,null", "--loop=inf", "--really-quiet",
     f"--title=greenlight-fake {title}", "av://lavfi:sine=frequency=260"],
    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    preexec_fn=_die_with_parent)


def bail(*_):
    mpv.terminate()
    sys.exit(0)


signal.signal(signal.SIGTERM, bail)
signal.signal(signal.SIGINT, bail)
sys.exit(mpv.wait())
