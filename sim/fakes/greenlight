#!/usr/bin/env python3
"""Fake Greenlight (xCloud) client (A-8): real X window, SIGTERM-clean.
Best-effort tier per spec — if the real client breaks, the tile just fails.
Usage: greenlight [--resolution WxH] [--fps N] [--bitrate K] <title-or-url>

Writes its full argv to /tmp/greenlight-argv so tests can assert the
per-app quality settings from state actually reached the client.
"""
import argparse
import ctypes
import signal
import subprocess
import sys


def _die_with_parent():
    ctypes.CDLL("libc.so.6", use_errno=True).prctl(1, signal.SIGKILL)


with open("/tmp/greenlight-argv", "w") as f:
    f.write(" ".join(sys.argv) + "\n")

ap = argparse.ArgumentParser()
ap.add_argument("--resolution", default="1920x1080")
ap.add_argument("--fps", default="60")
ap.add_argument("--bitrate", default="20000")
ap.add_argument("rest", nargs=argparse.REMAINDER)
args = ap.parse_args()
positional = [a for a in args.rest if not a.startswith("--")]
title = positional[0] if positional else "xcloud"
mpv = subprocess.Popen(
    ["mpv", "--no-config", "--vo=x11", "--force-window=yes",
     "--ao=pulse,pipewire,null", "--loop=inf", "--really-quiet",
     f"--title=greenlight-fake {title}", "av://lavfi:sine=frequency=260"],
    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    preexec_fn=_die_with_parent)


def bail(*_):
    mpv.terminate()
    sys.exit(0)


signal.signal(signal.SIGTERM, bail)
signal.signal(signal.SIGINT, bail)
sys.exit(mpv.wait())
