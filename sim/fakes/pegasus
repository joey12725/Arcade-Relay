#!/usr/bin/env python3
"""Fake Pegasus frontend (ASSUMPTIONS A-8): a real, persistent X window.

The watchdog contract (EMU-3) is "focus returns to the frontend within 2s".
This fake gives the sim a genuine frontend window ("pegasus-fake") that cabd
can locate/raise with xdotool, and that survives games coming and going.
Exits on SIGTERM. No UI logic — theming is M1 hardware/real-Pegasus work.
"""
import os
import signal
import subprocess
import sys

mpv = subprocess.Popen(
    ["mpv", "--no-config", "--vo=x11", "--loop=inf", "--really-quiet",
     "--title=pegasus-fake",
     "av://lavfi:color=c=0x102040"],  # calm blue: visibly 'the frontend'
    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def bail(*_):
    mpv.terminate()
    sys.exit(0)


signal.signal(signal.SIGTERM, bail)
signal.signal(signal.SIGINT, bail)
rc = mpv.wait()
sys.exit(rc)
