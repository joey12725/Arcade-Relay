// pegasus-y2k — cabinet home screen (UI-1..4).
//
// Layout follows the Y2K handoff design: per-system skin backdrop, a gel
// system rail down the left, a 3D cover carousel in the middle, a chrome
// header and a marquee footer, plus a tagged GIF mascot in the corner.
//
// Deliberate divergences from the mockup, all for the same reason (this runs
// on a 4:3 CRT driven by a joystick, not in a desktop browser):
//   - sizes are proportional to the real screen, not the mockup's 1024x768
//   - cover art is the real boxFront pegasus_gen attaches; the mockup's
//     generated gradient case is the fallback, not the default
//   - navigation is joystick + accept/back only (UI-4)
//
// Assets live in assets/ beside this file; DEPLOY.md copies the repo's
// assets/ tree in. Everything degrades to a flat colour if they are missing,
// so a theme installed without them still works.
import QtQuick 2.15
import QtMultimedia 5.15   // Pegasus ships Qt 5.15; unversioned import is Qt6-only
import "Systems.js" as Sys
import "assets/gif-index.js" as GifIndex

FocusScope {
    id: root
    // Compensate for the cabinet display's horizontal overscan.
    transform: Scale {
        origin.x: root.width / 2; origin.y: root.height / 2
        xScale: 0.90; yScale: 0.96
    }
    focus: true

    // --- design canvas. Every size below is written in mockup pixels and
    // scaled once here, so the layout holds on any panel the cabinet has.
    readonly property real ux: Math.min(width / 1024, height / 768)
    function u(v) { return Math.round(v * ux) }

    readonly property bool tacky: true      // blink/pulse/bob decorations

    // ------------------------------------------------------ collections
    // Favorites boots first (UI-2), everything else in api order.
    function sortedCollections() {
        var favs = [], rest = [];
        for (var i = 0; i < api.collections.count; i++) {
            var c = api.collections.get(i);
            (c.shortName === "favorites" ? favs : rest).push(c);
        }
        return favs.concat(rest);
    }
    property var collections: sortedCollections()
    property int collectionIndex: 0
    readonly property var currentCollection:
        collections.length ? collections[collectionIndex] : null
    readonly property var skin:
        Sys.forShortName(currentCollection ? currentCollection.shortName : "")
    readonly property int gameCount:
        currentCollection && currentCollection.games ? currentCollection.games.count : 0

    // Re-rolled on every system change so the mascot swaps as you browse.
    property int mascotRoll: 3
    property int stickerRoll: 101

    Rectangle { anchors.fill: parent; color: skin.bg }

    Image {
        anchors.fill: parent
        source: "assets/skins/" + skin.skin + ".png"
        fillMode: Image.Stretch
        asynchronous: true
        onStatusChanged: if (status === Image.Error) source = ""
    }

    // =================================================== tagged GIF pool
    // Generated by assets/build-gif-index.py: each entry carries the console
    // tags parsed out of its filename plus a blend mode.
    //
    // Imported as a JS library rather than fetched as JSON on purpose. Qt
    // 5.15 refuses XMLHttpRequest on local files unless QML_XHR_ALLOW_FILE_READ
    // is set, which we cannot set for the Pegasus process — a fetching theme
    // renders zero mascots on the cabinet and says nothing about why.
    readonly property var gifIndex: GifIndex.GIFS

    function gifPool(tags) {
        var hit = [], anyTag = [];
        for (var i = 0; i < gifIndex.length; i++) {
            var g = gifIndex[i];
            var matched = false;
            for (var t = 0; t < g.tags.length; t++) {
                if (tags.indexOf(g.tags[t]) >= 0) matched = true;
                if (g.tags[t] === "all") anyTag.push(g);
            }
            if (matched) hit.push(g);
        }
        return hit.length ? hit : anyTag;   // every system gets *something*
    }
    function pickGif(nonce) {
        var pool = gifPool(skin.gifTags);
        var i = Sys.pickIndex(nonce, pool.length);
        return i < 0 ? null : pool[i];
    }
    readonly property var mascotGif: gifIndex.length ? pickGif(mascotRoll + collectionIndex * 13) : null
    readonly property var stickerGif: gifIndex.length ? pickGif(stickerRoll + collectionIndex * 29) : null

    // ============================================================ header
    Rectangle {
        id: header
        x: u(26); y: u(14)
        width: parent.width - u(52); height: u(100)
        radius: u(16)
        border { width: u(4); color: skin.c1 }
        gradient: Gradient {
            GradientStop { position: 0.0; color: "#f5ffffff" }
            GradientStop { position: 1.0; color: Qt.rgba(skin.c1.r, skin.c1.g, skin.c1.b, 0.2) }
        }

        Row {
            anchors { left: parent.left; leftMargin: u(18); verticalCenter: parent.verticalCenter }
            spacing: u(18)

            Rectangle {
                width: u(72); height: u(72); radius: u(16)
                anchors.verticalCenter: parent.verticalCenter
                color: skin.c1
                border { width: u(4); color: "#ffffff" }
                Text {
                    anchors.centerIn: parent
                    text: skin.badge
                    color: "#ffffff"; font { pixelSize: u(32); bold: true }
                }
                SequentialAnimation on scale {
                    running: root.tacky; loops: Animation.Infinite
                    NumberAnimation { to: 1.07; duration: 1200; easing.type: Easing.InOutQuad }
                    NumberAnimation { to: 1.0;  duration: 1200; easing.type: Easing.InOutQuad }
                }
            }
            Column {
                anchors.verticalCenter: parent.verticalCenter
                spacing: u(2)
                Text {
                    text: skin.title
                    color: skin.c1
                    font { pixelSize: u(48); bold: true; letterSpacing: u(1) }
                    style: Text.Outline; styleColor: skin.ink
                }
                Text {
                    text: skin.sub.toUpperCase()
                    color: skin.ink; opacity: 0.8
                    font { pixelSize: u(19); bold: true; letterSpacing: u(2) }
                }
            }
        }

        Row {
            anchors { right: parent.right; rightMargin: u(18); verticalCenter: parent.verticalCenter }
            spacing: u(12)
            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: idxText.width + u(36); height: u(46); radius: u(24)
                color: "#ffffff"; border { width: u(4); color: skin.ink }
                Text {
                    id: idxText
                    anchors.centerIn: parent
                    text: (gameCount ? grid.currentIndex + 1 : 0) + " / " + gameCount
                    color: skin.ink; font { pixelSize: u(30); bold: true }
                }
            }
            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: cornerText.width + u(24); height: u(40); radius: u(8)
                color: skin.c3; rotation: -7
                border { width: u(4); color: "#ffffff" }
                Text {
                    id: cornerText
                    anchors.centerIn: parent
                    text: skin.corner
                    color: "#ffffff"; font { pixelSize: u(20); bold: true }
                }
                SequentialAnimation on opacity {
                    running: root.tacky; loops: Animation.Infinite
                    NumberAnimation { to: 0.15; duration: 600 }
                    NumberAnimation { to: 1.0;  duration: 600 }
                }
            }
        }
    }

    // ================================================ system rail (left)
    // Five gel pills centred on the current system, matching the mockup's
    // windowed list. Up/down moves systems (UI-4).
    Column {
        id: rail
        x: u(26); y: u(132)
        width: u(288)
        height: parent.height - u(264)
        spacing: u(9)

        Repeater {
            model: 5
            delegate: Rectangle {
                readonly property int offset: index - 2
                readonly property bool isCurrent: offset === 0
                readonly property var col: collections.length
                    ? collections[(collectionIndex + offset + collections.length * 2) % collections.length]
                    : null
                readonly property var railSkin: Sys.forShortName(col ? col.shortName : "")

                width: rail.width
                height: isCurrent ? u(62) : u(46)
                radius: u(14)
                visible: !!col
                color: isCurrent ? railSkin.c1 : "#f0ffffff"
                border { width: u(3); color: isCurrent ? "#ffffff" : "#c0ffffff" }
                x: isCurrent ? u(10) : 0
                Behavior on x { NumberAnimation { duration: 200; easing.type: Easing.OutBack } }
                Behavior on height { NumberAnimation { duration: 200; easing.type: Easing.OutBack } }

                Rectangle {
                    anchors { left: parent.left; leftMargin: u(12); verticalCenter: parent.verticalCenter }
                    width: parent.isCurrent ? u(18) : u(14)
                    height: width; radius: width
                    color: parent.isCurrent ? "#ffffff" : parent.railSkin.c1
                    border { width: u(3); color: parent.isCurrent ? skin.ink : "#66000000" }
                }
                Text {
                    anchors {
                        left: parent.left; leftMargin: u(44)
                        right: countPill.left; rightMargin: u(8)
                        verticalCenter: parent.verticalCenter
                    }
                    text: col ? col.name : ""
                    elide: Text.ElideRight
                    color: parent.isCurrent ? "#ffffff" : skin.ink
                    font { pixelSize: parent.isCurrent ? u(24) : u(19); bold: true }
                }
                Rectangle {
                    id: countPill
                    anchors { right: parent.right; rightMargin: u(12); verticalCenter: parent.verticalCenter }
                    width: countText.width + u(16); height: countText.height + u(4)
                    radius: u(10)
                    color: parent.isCurrent ? "#4d000000" : "#24000000"
                    Text {
                        id: countText
                        anchors.centerIn: parent
                        text: parent.parent.col && parent.parent.col.games
                              ? parent.parent.col.games.count : 0
                        color: parent.parent.isCurrent ? "#ffffff" : skin.ink
                        font { pixelSize: parent.parent.isCurrent ? u(17) : u(14); bold: true }
                    }
                }
            }
        }
    }

    // ============================================== cover carousel (mid)
    // A PathView gives the mockup's 3D fan for free and, unlike the mockup's
    // absolutely-positioned clones, only instantiates what is on screen —
    // which matters when a collection holds a few thousand roms.
    PathView {
        id: grid
        anchors {
            left: rail.right; leftMargin: u(38)
            right: parent.right; rightMargin: u(214)
            top: header.bottom; topMargin: u(8)
            bottom: footer.top; bottomMargin: u(16)
        }
        focus: true
        model: currentCollection ? currentCollection.games : null
        pathItemCount: 3
        preferredHighlightBegin: 0.5
        preferredHighlightEnd: 0.5
        highlightRangeMode: PathView.StrictlyEnforceRange
        snapMode: PathView.SnapOneItem
        movementDirection: PathView.Negative
        clip: false

        readonly property real caseW: u(286)
        readonly property real caseH: u(404)

        path: Path {
            startX: grid.width / 2 - u(170); startY: grid.height / 2
            PathAttribute { name: "z";     value: 10 }
            PathAttribute { name: "scale"; value: 0.62 }
            PathAttribute { name: "ang";   value: 36 }
            PathLine { x: grid.width / 2; y: grid.height / 2 }
            PathAttribute { name: "z";     value: 20 }
            PathAttribute { name: "scale"; value: 1.0 }
            PathAttribute { name: "ang";   value: 0 }
            PathLine { x: grid.width / 2 + u(170); y: grid.height / 2 }
            PathAttribute { name: "z";     value: 10 }
            PathAttribute { name: "scale"; value: 0.62 }
            PathAttribute { name: "ang";   value: -36 }
        }

        delegate: Item {
            id: coverItem
            width: grid.caseW; height: grid.caseH
            z: PathView.z === undefined ? 1 : PathView.z
            scale: PathView.scale === undefined ? 1 : PathView.scale
            readonly property bool isCurrent: PathView.isCurrentItem
            readonly property var art: Sys.coverColors(modelData.title)

            transform: Rotation {
                origin { x: coverItem.width / 2; y: coverItem.height / 2 }
                axis { x: 0; y: 1; z: 0 }
                angle: coverItem.PathView.ang === undefined ? 0 : coverItem.PathView.ang
            }

            Rectangle {                       // the case
                anchors.fill: parent
                radius: u(10)
                color: skin.caseFace
                border { width: u(6); color: skin.caseInk }

                Rectangle {                   // spine
                    id: spine
                    width: u(34); height: parent.height
                    color: skin.caseInk
                    radius: u(4)
                    Text {
                        anchors.centerIn: parent
                        rotation: 90
                        text: skin.code
                        color: "#ffffff"
                        font { pixelSize: u(17); bold: true; letterSpacing: u(2) }
                    }
                }

                Item {                        // art well
                    anchors {
                        left: spine.right; top: parent.top; right: parent.right; bottom: parent.bottom
                        margins: u(8)
                    }
                    clip: true

                    // Generated fallback: shown until (or unless) real art loads.
                    Rectangle {
                        anchors.fill: parent
                        radius: u(5)
                        visible: boxArt.status !== Image.Ready
                        gradient: Gradient {
                            GradientStop { position: 0.0; color: Qt.hsla(coverItem.art[0], 0.75, 0.55, 1) }
                            GradientStop { position: 1.0; color: Qt.hsla(coverItem.art[1], 0.8, 0.62, 1) }
                        }
                        Text {
                            anchors {
                                centerIn: parent
                                margins: u(14)
                            }
                            width: parent.width - u(28)
                            text: modelData.title
                            wrapMode: Text.WordWrap
                            horizontalAlignment: Text.AlignHCenter
                            color: "#ffffff"
                            font { pixelSize: u(30); bold: true }
                            style: Text.Outline; styleColor: "#66000000"
                        }
                    }

                    Image {
                        id: boxArt
                        anchors.fill: parent
                        source: modelData.assets.boxFront || modelData.assets.logo || ""
                        fillMode: Image.PreserveAspectCrop
                        asynchronous: true
                        cache: false          // libraries outgrow the pixmap cache
                    }

                    // trailer preview: ALWAYS muted (AUD-2; policy also mutes)
                    Loader {
                        anchors.fill: parent
                        active: coverItem.isCurrent && !!modelData.assets.video
                        sourceComponent: Video {
                            source: modelData.assets.video
                            muted: true; autoPlay: true; loops: -1
                            fillMode: VideoOutput.PreserveAspectCrop
                        }
                    }

                    Rectangle {               // gloss
                        anchors.fill: parent
                        rotation: -18
                        opacity: 0.35
                        gradient: Gradient {
                            GradientStop { position: 0.0;  color: "#ccffffff" }
                            GradientStop { position: 0.35; color: "#10ffffff" }
                            GradientStop { position: 1.0;  color: "#00ffffff" }
                        }
                    }

                    // No title plate over real box art: the box already has
                    // the title printed on it, and the footer repeats it. The
                    // generated fallback above draws its own.
                }
            }

            Image {                           // favourite star
                anchors { top: parent.top; right: parent.right
                          topMargin: -u(24); rightMargin: -u(20) }
                width: u(106); height: u(106)
                source: "assets/sprites/star.png"
                visible: modelData.favorite && coverItem.isCurrent
                asynchronous: true
                onStatusChanged: if (status === Image.Error) source = ""
                SequentialAnimation on scale {
                    running: root.tacky; loops: Animation.Infinite
                    NumberAnimation { to: 1.1; duration: 750; easing.type: Easing.InOutQuad }
                    NumberAnimation { to: 1.0; duration: 750; easing.type: Easing.InOutQuad }
                }
            }
        }

        // UI-4: joystick + accept/back, plus one dedicated favourite button.
        Keys.onPressed: (event) => {
            if (api.keys.isAccept(event)) {
                event.accepted = true;
                if (event.isAutoRepeat) return;
                if (currentCollection && gameCount > 0)
                    currentCollection.games.get(grid.currentIndex).launch();
            } else if (event.key === Qt.Key_Left) {
                event.accepted = true;
                if (gameCount > 0) grid.decrementCurrentIndex();
            } else if (event.key === Qt.Key_Right) {
                event.accepted = true;
                if (gameCount > 0) grid.incrementCurrentIndex();
            } else if (event.key === Qt.Key_Down || api.keys.isNextPage(event)) {
                event.accepted = true;
                root.moveSystem(1);
            } else if (event.key === Qt.Key_Up || api.keys.isPrevPage(event)) {
                event.accepted = true;
                root.moveSystem(-1);
            } else if (api.keys.isDetails(event)) {
                // NOTE: toggles Pegasus's internal favourite flag (star badge
                // only). The authoritative list is state/library/favorites.yaml
                // (arcadectl favorites ...) and the generated Favorites
                // collection follows that, not this flag. See HARDWARE-TODO.
                event.accepted = true;
                if (gameCount > 0) {
                    var g = currentCollection.games.get(grid.currentIndex);
                    g.favorite = !g.favorite;
                }
            }
        }
    }

    function moveSystem(delta) {
        if (!collections.length) return;
        collectionIndex = (collectionIndex + delta + collections.length) % collections.length;
        mascotRoll += 1 + Math.floor(Math.random() * 7);
        stickerRoll += 1 + Math.floor(Math.random() * 5);
        wipe.restart();
    }

    // ================================================= corner GIF mascot
    // The bit the design is really about: a tagged GIF that matches the
    // system you are looking at. blend 1 = multiply (white-background art),
    // blend 2 = framed sticker, 0 = plain sprite.
    AnimatedImage {
        id: mascot
        visible: !!root.mascotGif && status === AnimatedImage.Ready
        source: root.mascotGif ? "assets/gifs/" + root.mascotGif.file : ""
        anchors { right: parent.right; rightMargin: u(14)
                  bottom: footer.top; bottomMargin: u(18) }
        readonly property real cap: u(178)
        readonly property real k: root.mascotGif
            ? Math.min(cap / root.mascotGif.w, cap / root.mascotGif.h, 2.4) : 1
        width: root.mascotGif ? root.mascotGif.w * k : 0
        height: root.mascotGif ? root.mascotGif.h * k : 0
        fillMode: Image.PreserveAspectFit
        asynchronous: true
        SequentialAnimation on y {
            running: root.tacky && mascot.visible; loops: Animation.Infinite
            NumberAnimation { to: mascot.y - u(12); duration: 2500; easing.type: Easing.InOutQuad }
            NumberAnimation { to: mascot.y;         duration: 2500; easing.type: Easing.InOutQuad }
        }
    }

    AnimatedImage {
        id: sticker
        visible: !!root.stickerGif && status === AnimatedImage.Ready
        source: root.stickerGif ? "assets/gifs/" + root.stickerGif.file : ""
        anchors { left: parent.left; leftMargin: u(30)
                  bottom: footer.top; bottomMargin: u(26) }
        readonly property real cap: u(84)
        readonly property real k: root.stickerGif
            ? Math.min(cap / root.stickerGif.w, cap / root.stickerGif.h, 2.4) : 1
        width: root.stickerGif ? root.stickerGif.w * k : 0
        height: root.stickerGif ? root.stickerGif.h * k : 0
        rotation: -8
        fillMode: Image.PreserveAspectFit
        asynchronous: true
    }

    // ============================================================ footer
    Rectangle {
        id: footer
        x: u(26); width: parent.width - u(52)
        height: u(112)
        y: parent.height - height - u(14)
        radius: u(16)
        clip: true
        color: "#f5ffffff"
        border { width: u(4); color: skin.c1 }

        Row {
            anchors { left: parent.left; leftMargin: u(18); right: parent.right
                      rightMargin: u(18); top: parent.top }
            height: u(74)
            spacing: u(14)

            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: launchHint.width + u(36); height: u(50); radius: u(26)
                color: "#17b34a"; border { width: u(4); color: "#ffffff" }
                Text {
                    id: launchHint
                    anchors.centerIn: parent
                    text: "A  LAUNCH"; color: "#ffffff"
                    font { pixelSize: u(24); bold: true }
                }
            }
            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: favHint.width + u(36); height: u(50); radius: u(26)
                color: skin.c1; border { width: u(4); color: "#ffffff" }
                Text {
                    id: favHint
                    anchors.centerIn: parent
                    text: "Y  FAV"; color: "#ffffff"
                    font { pixelSize: u(24); bold: true }
                }
            }
            Text {
                anchors.verticalCenter: parent.verticalCenter
                width: parent.width - launchHint.width - favHint.width - clockBox.width - u(130)
                text: gameCount > 0 && currentCollection
                      ? currentCollection.games.get(grid.currentIndex).title : ""
                elide: Text.ElideRight
                horizontalAlignment: Text.AlignHCenter
                color: skin.ink
                font { pixelSize: u(26); bold: true }
            }
            Rectangle {
                id: clockBox
                anchors.verticalCenter: parent.verticalCenter
                width: clockText.width + u(24); height: u(46); radius: u(8)
                color: "#111111"; border { width: u(3); color: skin.c2 }
                Text {
                    id: clockText
                    anchors.centerIn: parent
                    color: "#ffffff"
                    font { pixelSize: u(28); bold: true }
                    text: Qt.formatTime(new Date(), "hh:mm")
                    Timer {
                        interval: 10000; running: true; repeat: true
                        onTriggered: clockText.text = Qt.formatTime(new Date(), "hh:mm")
                    }
                }
            }
        }

        Rectangle {                            // marquee strip
            anchors { left: parent.left; right: parent.right; bottom: parent.bottom }
            height: u(38)
            color: skin.ink
            clip: true
            Row {
                id: marqueeRow
                anchors.verticalCenter: parent.verticalCenter
                spacing: u(70)
                Text {
                    text: skin.marquee; color: skin.c2
                    font { pixelSize: u(21); bold: true; letterSpacing: u(1) }
                }
                Text {
                    text: skin.marquee; color: skin.c2
                    font { pixelSize: u(21); bold: true; letterSpacing: u(1) }
                }
                NumberAnimation on x {
                    running: root.tacky
                    loops: Animation.Infinite
                    from: 0; to: -(marqueeRow.width / 2 + u(70))
                    duration: 26000
                }
            }
        }
    }

    // ------------------------------------------------- system-change wipe
    Rectangle {
        id: wipeRect
        anchors.fill: parent
        visible: wipe.running
        opacity: 0
        z: 30
        gradient: Gradient {
            orientation: Gradient.Horizontal
            GradientStop { position: 0.0;  color: "#00ffffff" }
            GradientStop { position: 0.45; color: "#ddffffff" }
            GradientStop { position: 0.55; color: Qt.rgba(skin.c1.r, skin.c1.g, skin.c1.b, 0.85) }
            GradientStop { position: 1.0;  color: "#00ffffff" }
        }
        SequentialAnimation {
            id: wipe
            ParallelAnimation {
                NumberAnimation { target: wipeRect; property: "opacity"; from: 0.9; to: 0; duration: 420 }
                NumberAnimation { target: wipeRect; property: "x"
                                  from: -root.width; to: root.width; duration: 420
                                  easing.type: Easing.OutQuad }
            }
            ScriptAction { script: wipeRect.x = 0 }
        }
    }
}
