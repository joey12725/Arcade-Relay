# Only the calibrated virtual panels may navigate Pegasus. No analog or
# trigger mappings: panel buttons 7/8 must never masquerade as stick axes.
SDL_GAMECONTROLLER_IGNORE_DEVICES="0x0c12/0x0c30"
SDL_GAMECONTROLLERCONFIG="0300000055f000000100000011010000,Arcade Left Panel,a:b0,b:b1,x:b3,y:b4,back:b8,start:b9,dpup:h0.1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,platform:Linux,
0300000055f000000200000011010000,Arcade Right Panel,a:b0,b:b1,x:b3,y:b4,back:b8,start:b9,dpup:h0.1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,platform:Linux,"
