# Only the calibrated virtual panels may navigate Pegasus. No analog or
# trigger mappings: panel buttons 7/8 must never masquerade as stick axes.
# Buttons follow the NINTENDO panel layout (panel_layout.py; bN = code - 304):
# 1 a, 5 b, 6 x, 2 y, 3 leftshoulder, 4 rightshoulder, 7 start, 8 back.
SDL_GAMECONTROLLER_IGNORE_DEVICES="0x0c12/0x0c30"
SDL_GAMECONTROLLERCONFIG="0300000055f000000100000011010000,Arcade Left Panel,a:b0,b:b1,x:b2,y:b3,leftshoulder:b5,rightshoulder:b4,back:b6,start:b7,dpup:h0.1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,platform:Linux,
0300000055f000000200000011010000,Arcade Right Panel,a:b0,b:b1,x:b2,y:b3,leftshoulder:b5,rightshoulder:b4,back:b6,start:b7,dpup:h0.1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,platform:Linux,"
