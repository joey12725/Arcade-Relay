# cabd — the cabinet daemon (spec §5.2). systemd user unit.
# @SERVER_HOST@ is substituted by provision/install.sh.
[Unit]
Description=arcade cabinet daemon (cabd)

[Service]
Environment=DISPLAY=:0
Environment=CABD_PANEL_BRIDGE=1
Environment=SERVER_WS_URL=wss://@SERVER_HOST@/cab
Environment=CABD_MEDIA_BASE=https://@SERVER_HOST@
Environment=RETROARCH_BIN=/usr/bin/retroarch
Environment=REAL_RETROARCH=/usr/bin/retroarch
# Pegasus is owned by pegasus.service (single supervisor) — empty
# FRONTEND_BIN disables cabd's own spawn loop; the watchdog still refocuses
# the frontend window by title. Anchored: xdotool --name is a
# case-insensitive regex, and a bare "pegasus" also matches Qt's hidden
# helper windows ("pegasus-frontend" client leader, "Qt Selection Owner for
# pegasus-fe"). focus_window maps whatever it is given, so a helper match
# mapped a 1x1 window over the menu and stole all keyboard/pad input.
Environment=FRONTEND_BIN=
Environment=FRONTEND_TITLE=^Pegasus$
Environment=STATE_CACHE=/var/cache/arcade/state.json
Environment=CABD_SAVES_DIR=/saves
# Real session binaries (sim defaults point at /fakes/*). Paths match the
# DEPLOY.md §3 install steps.
Environment=STEAM_BIN=/usr/bin/steam
Environment=MOONLIGHT_BIN=/usr/bin/moonlight-qt
Environment=GREENLIGHT_BIN=/usr/local/bin/greenlight
ExecStart=/usr/bin/python3 /opt/arcade/cabinet/cabd.py
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
