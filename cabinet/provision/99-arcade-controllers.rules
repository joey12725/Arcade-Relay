# Stable identities for the panel's controller boards across reboots
# (spec §5.5). The cabinet's boards are Brook P4 encoders, which enumerate
# under TWO identities depending on the mode they power up in:
#   - PS4 mode:    0c12:0c30 "Brook P4 Wired Gamepad"   (hid-generic)
#   - XInput mode: 045e:02ea "Microsoft X-Box One S pad" (xpad)
# Cover both, and keep the old DragonRise ids for any future zero-delay
# encoder. Re-run after edits: udevadm control --reload
SUBSYSTEM=="input", ATTRS{idVendor}=="0c12", ATTRS{idProduct}=="0c30", ENV{ID_INPUT_JOYSTICK}=="1", MODE="0664", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="02ea", ENV{ID_INPUT_JOYSTICK}=="1", MODE="0664", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="0079", ENV{ID_INPUT_JOYSTICK}=="1", MODE="0664", GROUP="input", TAG+="uaccess"
# Any joystick-class device: readable by the arcade session (evdev input layer)
KERNEL=="event*", ENV{ID_INPUT_JOYSTICK}=="1", MODE="0664", GROUP="input"
# Raw boards are consumed by the calibrated bridge; only its stable player
# pads should occupy RetroArch ports. Both remain readable by cabd.
SUBSYSTEM=="input", ATTRS{idVendor}=="0c12", ATTRS{idProduct}=="0c30", ENV{ID_INPUT_JOYSTICK}="0", ENV{ID_INPUT}="0", MODE="0660", GROUP="input"
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"
