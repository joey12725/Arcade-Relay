#!/usr/bin/env python3
"""cabd-launch — local launch shim (spec §5.3, prime directive 1).

Pegasus launch commands go through this, never exec emulators directly and
never touch the network: cabd always knows what's running, renders configs
first, and can kill cleanly.

Usage:
  cabd-launch <system> <rom-path> [extra emulator args...]
  cabd-launch kill
  cabd-launch running
Exit codes: 0 ok, 1 cabd reported an error, 3 cabd socket unreachable.
"""
import json
import os
import socket
import sys

SOCK = os.environ.get("CABD_SOCK", "/tmp/cabd.sock")


def main():
    argv = sys.argv[1:]
    if not argv:
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    if argv[0] == "kill":
        req = {"method": "game.kill", "params": {}}
    elif argv[0] == "running":
        req = {"method": "game.running", "params": {}}
    else:
        if len(argv) < 2:
            print("usage: cabd-launch <system> <rom-path> [args...]", file=sys.stderr)
            sys.exit(2)
        req = {"method": "game.launch",
               "params": {"system": argv[0], "path": argv[1], "args": argv[2:]}}

    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(15)
        s.connect(SOCK)
        s.sendall((json.dumps(req) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(4096)
            if not chunk:
                break
            buf += chunk
    except OSError as e:
        print(f"cabd-launch: cannot reach cabd at {SOCK}: {e}", file=sys.stderr)
        sys.exit(3)

    res = json.loads(buf)
    print(json.dumps(res))
    sys.exit(0 if res.get("ok") else 1)


if __name__ == "__main__":
    main()
