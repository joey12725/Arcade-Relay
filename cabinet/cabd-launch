#!/usr/bin/env python3
"""cabd-launch — local launch shim (spec §5.3, prime directive 1).

Pegasus launch commands go through this, never exec emulators directly and
never touch the network: cabd always knows what's running, renders configs
first, and can kill cleanly.

Usage:
  cabd-launch <system> <rom-path> [extra emulator args...]
  cabd-launch --wait <system> <rom-path>   # Pegasus: wait until game exits
  cabd-launch kill
  cabd-launch running
Exit codes: 0 ok, 1 cabd reported an error, 3 cabd socket unreachable.
"""
import json
import os
import socket
import sys
import time

SOCK = os.environ.get("CABD_SOCK", "/tmp/cabd.sock")


def request(req):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(30)
        s.connect(SOCK)
        s.sendall((json.dumps(req) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(4096)
            if not chunk:
                break
            buf += chunk
    return json.loads(buf)


def main():
    argv = sys.argv[1:]
    wait = bool(argv and argv[0] == "--wait")
    if wait:
        argv = argv[1:]
    if not argv:
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    if argv[0] == "kill":
        req = {"method": "game.kill", "params": {}}
    elif argv[0] == "running":
        req = {"method": "game.running", "params": {}}
    else:
        if len(argv) < 2:
            print("usage: cabd-launch <system> <rom-path> [args...]", file=sys.stderr)
            sys.exit(2)
        req = {"method": "game.launch",
               "params": {"system": argv[0], "path": argv[1], "args": argv[2:]}}

    try:
        res = request(req)
        print(json.dumps(res), flush=True)
        # Pegasus keeps the launcher in the foreground until this process
        # exits. Returning immediately steals focus from the running game
        # and can replay held controller buttons into the frontend.
        if wait and res.get("ok") and req["method"] == "game.launch":
            running = res["result"]["running"]
            while True:
                time.sleep(0.25)
                status = request({"method": "game.running"})
                if not status.get("ok") or status["result"]["running"] != running:
                    break
    except OSError as e:
        print(f"cabd-launch: cannot reach cabd at {SOCK}: {e}", file=sys.stderr)
        sys.exit(3)

    sys.exit(0 if res.get("ok") else 1)


if __name__ == "__main__":
    main()
